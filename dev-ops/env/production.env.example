# Template for the production build env file (source/env/.production).
# Do NOT commit real values. Fill this in, then paste the whole content into the
# APP_ENV_FILE secret of the "prod" GitHub Environment. CI writes it to source/env/.production
# before `npm run build:production`.
# Every REACT_APP_* value is baked into the JS bundle and visible in the browser.

REACT_APP_API = https://<prod-sso-api-domain>/
REACT_APP_API_MEDIA = https://<prod-media-domain>/

# Part of the localStorage key names; changing it later logs every user out
REACT_APP_ENV = production
GENERATE_SOURCEMAP = false
CI = false

REACT_APP_USERNAME = <basic-auth-client-username>
REACT_APP_PASSWORD = <basic-auth-client-password>

REACT_APP_SECRET_ID = <secret-id-of-this-cms-in-prod-sso>
REACT_APP_APP_ID = <app-id-of-this-cms-in-prod-sso>

REACT_APP_USER_KINDS = [ "1" ]
