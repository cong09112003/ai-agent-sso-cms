{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(npm run lint)",
            "Bash(npm test:*)",
            "Bash(npm run build:dev)",
            "Bash(npm run build:beta)",
            "Bash(npm run build:staging)",
            "Bash(node .claude/scripts/run-tests.js:*)",
            "Bash(node ../.claude/scripts/run-tests.js:*)",
            "Bash(npx eslint:*)",
            "Bash(npx prettier --check:*)",
            "Bash(npx prettier --list-different:*)",
            "Bash(npm ls:*)",
            "Bash(npm outdated:*)",
            "Bash(npm audit)",
            "Bash(npm audit --omit=dev)",
            "Bash(node -v)",
            "Bash(npm -v)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git blame:*)",
            "Bash(git branch)",
            "Bash(git branch --show-current)"
        ],
        "ask": [
            "Bash(npm install:*)",
            "Bash(npm i:*)",
            "Bash(npm ci:*)",
            "Bash(npm uninstall:*)",
            "Bash(npm update:*)",
            "Bash(npm audit fix:*)",
            "Bash(npm run format:*)",
            "Bash(npm run i18n:*)",
            "Bash(npm run build:production:*)",
            "Bash(git commit:*)",
            "Bash(git push:*)",
            "Bash(git checkout:*)",
            "Bash(git rebase:*)",
            "Bash(git merge:*)",
            "Edit(/source/package.json)",
            "Edit(/source/craco.config.js)",
            "Edit(/source/jsconfig.json)",
            "Edit(/source/.babelrc)",
            "Edit(/source/.eslintrc.json)",
            "Edit(/source/.prettierrc)",
            "Edit(/source/.husky/**)",
            "Edit(/source/appServer.js)",
            "Edit(/Dockerfile)",
            "Edit(/docker-compose.yaml)",
            "Edit(/dev-ops/**)",
            "Edit(/.claude/settings.json)"
        ],
        "deny": [
            "Read(/source/env/.local)",
            "Read(/source/env/.prod*)",
            "Edit(/source/env/**)",
            "Edit(/source/env/.*)",
            "Edit(/source/package-lock.json)",
            "Edit(/package-lock.json)",
            "Edit(/source/node_modules/**)",
            "Edit(/source/build/**)",
            "Bash(git push --force:*)",
            "Bash(git push -f:*)",
            "Bash(git push --force-with-lease:*)",
            "Bash(git reset --hard:*)",
            "Bash(git clean:*)",
            "Bash(git commit --no-verify:*)",
            "Bash(npm publish:*)",
            "Bash(npm run eject:*)",
            "Bash(npx react-scripts eject:*)",
            "Bash(rm -rf /:*)",
            "Bash(rm -rf ~:*)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|MultiEdit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/eslint-check.js\"",
                        "timeout": 30
                    }
                ]
            }
        ]
    }
}
